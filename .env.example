# Copia in .env.local e riempi con i valori di Firebase (Impostazioni progetto > Le tue app > Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tuo-progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tuo-progetto
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Notifiche web: Impostazioni progetto → Cloud Messaging → Certificati push web → Genera coppia di chiavi
VITE_FIREBASE_VAPID_KEY=

# Indirizzo pubblico della versione web: è dove punta il link di accesso via email
VITE_PUBLIC_URL=https://tuo-progetto.web.app

# Identificativi delle app native (gli stessi di capacitor.config.ts)
VITE_IOS_BUNDLE_ID=it.inpiazza.app
VITE_ANDROID_PACKAGE=it.inpiazza.app

# Mappa e routing (facoltativi: questi sono i valori predefiniti)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_ROUTER_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot/

# Solo su Vercel (non servono nell'app)
# Notifiche push: JSON dell'account di servizio (Impostazioni progetto → Account di servizio → Genera nuova chiave)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Facoltativo: anche email per le nuove richieste organizzatore
# RESEND_API_KEY=re_...
# ADMIN_EMAIL=tua@email.it
# MAIL_FROM="In Piazza <avvisi@tuodominio.it>"
